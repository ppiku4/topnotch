{
  "name": "topnotch",
  "productName": "TopNotch",
  "version": "0.1.6",
  "description": "A Dynamic Island for Windows: media, synced lyrics, system stats and quick controls in a notch at the top of your screen.",
  "license": "MIT",
  "author": "TopNotch contributors",
  "homepage": "https://github.com/ppiku4/topnotch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ppiku4/topnotch.git"
  },
  "bugs": {
    "url": "https://github.com/ppiku4/topnotch/issues"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env TOPNOTCH_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12",
    "ag-psd": "^31.0.3",
    "electron-updater": "6.8.9",
    "framer-motion": "^11.18.2",
    "koffi": "^2.9.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "onnxruntime-node": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.topnotch.app",
    "productName": "TopNotch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/ag-psd/{src,dist-es}/**",
      "!node_modules/onnxruntime-node/script/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "asarUnpack": [
      "electron/system-helper.cs",
      "electron/system-helper.ps1",
      "**/*.node",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "files": [
        "!node_modules/koffi/build/koffi/!(win32_x64)/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/{dxcompiler,dxil}.dll",
        "!electron/mac/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ppiku4",
        "repo": "topnotch",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "TopNotch-${version}-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "files": [
        "!node_modules/koffi/build/koffi/!(darwin_arm64)/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!electron/system-helper.{cs,ps1}",
        "!node_modules/@coooookies/**"
      ],
      "extraResources": [
        {
          "from": "build/mac/topnotch-helper",
          "to": "topnotch-helper"
        },
        {
          "from": "build/mac/mediaremote",
          "to": "mediaremote"
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "TopNotch asks Finder which file you Option-clicked, to open the file wheel.",
        "NSBluetoothAlwaysUsageDescription": "TopNotch shows your Bluetooth devices and their battery levels."
      }
    },
    "dmg": {
      "title": "TopNotch ${version}"
    }
  }
}

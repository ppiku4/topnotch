{
  "name": "topnotch",
  "productName": "TopNotch",
  "version": "0.1.12",
  "description": "Free Dynamic Island for Windows and macOS: now playing with synced lyrics, volume mixer, Bluetooth, clipboard history, focus timer, system stats, file shelf and a file converter with AI background removal.",
  "license": "MIT",
  "author": "TopNotch contributors",
  "homepage": "https://github.com/ppiku4/topnotch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ppiku4/topnotch.git"
  },
  "bugs": {
    "url": "https://github.com/ppiku4/topnotch/issues"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/regression.test.cjs",
    "test:native": "node tests/native-smoke.cjs && node tests/native-restart-smoke.cjs",
    "test:ui": "node tests/run-ui-smoke.cjs",
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env TOPNOTCH_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12",
    "ag-psd": "^31.0.3",
    "electron-updater": "6.8.9",
    "framer-motion": "^11.18.2",
    "koffi": "^2.9.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "onnxruntime-node": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.5",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.9.3": true
  },
  "build": {
    "appId": "com.topnotch.app",
    "productName": "TopNotch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/ag-psd/{src,dist-es}/**",
      "!node_modules/onnxruntime-node/script/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
    ],
    "asarUnpack": [
      "electron/image-decode.cjs",
      "electron/image-codecs.cjs",
      "electron/system-helper.cs",
      "electron/system-helper.ps1",
      "**/*.node",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "files": [
        "!node_modules/koffi/build/koffi/!(win32_x64)/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/{dxcompiler,dxil}.dll",
        "!electron/mac/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ppiku4",
        "repo": "topnotch",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "TopNotch-${version}-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "files": [
        "!node_modules/koffi/build/koffi/!(darwin_arm64)/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!electron/system-helper.{cs,ps1}",
        "!node_modules/@coooookies/**"
      ],
      "extraResources": [
        {
          "from": "build/mac/topnotch-helper",
          "to": "topnotch-helper"
        },
        {
          "from": "build/mac/mediaremote",
          "to": "mediaremote"
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "TopNotch asks Finder which file you Option-clicked, to open the file wheel.",
        "NSBluetoothAlwaysUsageDescription": "TopNotch shows your Bluetooth devices and their battery levels.",
        "NSDesktopFolderUsageDescription": "TopNotch reads files you convert from the Desktop and saves the converted copy next to them.",
        "NSDocumentsFolderUsageDescription": "TopNotch reads files you convert from Documents and saves the converted copy next to them.",
        "NSDownloadsFolderUsageDescription": "TopNotch reads files you convert from Downloads and saves the converted copy next to them.",
        "NSRemovableVolumesUsageDescription": "TopNotch converts files on external drives and saves the copy next to the original.",
        "NSNetworkVolumesUsageDescription": "TopNotch converts files on network drives and saves the copy next to the original."
      }
    },
    "dmg": {
      "title": "TopNotch ${version}"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "overrides": {
    "builder-util-runtime": "^9.7.0"
  }
}
